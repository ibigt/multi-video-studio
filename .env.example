# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
ACCESS_LOG=true

# ---------- 存储 ----------
# 所有相对路径都相对于项目根目录
DATA_DIR=./data
# RECORDINGS_DIR=./data/recordings
# HLS_DIR=./data/hls
# LOGS_DIR=./data/logs
# DATABASE_URL=sqlite+aiosqlite:///./data/rtsp_studio.db

# ---------- FFmpeg ----------
# 已加入 PATH 时无需修改
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# ---------- 连接检测 / 重连 ----------
STREAM_TIMEOUT_SECONDS=10
STATUS_CHECK_INTERVAL_SECONDS=15
STATUS_CONCURRENCY=8
AUTO_RECONNECT_DEFAULT=true
RECONNECT_DELAY_SECONDS=3

# ---------- 浏览器预览转码 ----------
PREVIEW_WIDTH=1280
PREVIEW_FPS=15
PREVIEW_BITRATE=1500k
PREVIEW_HLS_TIME=1
PREVIEW_HLS_LIST_SIZE=6
PREVIEW_IDLE_TIMEOUT_SECONDS=75

# ---------- 录制 ----------
# 视频码率、音频码率、编码预设
RECORDING_BITRATE=2500k
RECORDING_AUDIO_BITRATE=96k
RECORDING_PRESET=veryfast
# 0 表示手动停止；大于 0 时单次录制达到该秒数后自动保存
RECORDING_MAX_SECONDS=0
RECORDING_STOP_TIMEOUT_SECONDS=12
